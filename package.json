{
  "name": "stockkeep",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Multi-tenant inventory for Indian computer shops and bike service centres. One Node process on Catalyst AppSail, with Catalyst Data Store tables in the same shape as TechCizHRMS.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server/start.mjs",
    "start": "NODE_ENV=production node server/start.mjs",
    "build": "vite build --config client/vite.config.js",
    "test": "node --test server/isolation.test.mjs",
    "seed": "node server/seed.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "express": "^4.21.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "vite": "^6.3.6",
    "zcatalyst-sdk-node": "^2.5.1"
  }
}
